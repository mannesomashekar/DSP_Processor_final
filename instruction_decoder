`timescale 1ns / 1ps

module instruction_decoder(
    input [31:0] instruction,

    output reg [5:0] opcode,
    output reg [3:0] rd,
    output reg [3:0] rs1,
    output reg [3:0] rs2,
    output reg [4:0] alu_control,

    output reg alu_enable,
    output reg simd_enable,

    output reg reg_write,
    output reg alu_src,

    output reg mem_read,
    output reg mem_write,
    output reg mem_to_reg
);

always @(*)
begin
    opcode = instruction[31:26];
    rd = instruction[25:22];
    rs1 = instruction[21:18];
    rs2 = instruction[17:14];
    alu_control = 5'b00000;

    alu_enable = 1'b0;
    simd_enable = 1'b0;

    reg_write = 1'b0;
    alu_src = 1'b0;

    mem_read = 1'b0;
    mem_write = 1'b0;
    mem_to_reg = 1'b0;

    case (opcode)

        6'b000000: begin alu_enable=1'b1; alu_control=5'b00000; reg_write=1'b1; end
        6'b000001: begin alu_enable=1'b1; alu_control=5'b00001; reg_write=1'b1; end
        6'b000010: begin alu_enable=1'b1; alu_control=5'b00010; reg_write=1'b1; end
        6'b000011: begin alu_enable=1'b1; alu_control=5'b00011; reg_write=1'b1; end
        6'b000100: begin alu_enable=1'b1; alu_control=5'b00100; reg_write=1'b1; end
        6'b000101: begin alu_enable=1'b1; alu_control=5'b00101; reg_write=1'b1; end
        6'b000110: begin alu_enable=1'b1; alu_control=5'b00110; reg_write=1'b1; end
        6'b000111: begin alu_enable=1'b1; alu_control=5'b00111; reg_write=1'b1; end
        6'b001000: begin alu_enable=1'b1; alu_control=5'b01000; reg_write=1'b1; end
        6'b001001: begin alu_enable=1'b1; alu_control=5'b01001; reg_write=1'b1; end
        6'b001010: begin alu_enable=1'b1; alu_control=5'b01010; reg_write=1'b1; end
        6'b001011: begin alu_enable=1'b1; alu_control=5'b01011; reg_write=1'b1; end
        6'b001100: begin alu_enable=1'b1; alu_control=5'b01100; reg_write=1'b1; end
        6'b001101: begin alu_enable=1'b1; alu_control=5'b01101; reg_write=1'b1; end
        6'b001110: begin alu_enable=1'b1; alu_control=5'b01110; reg_write=1'b1; end
        6'b001111: begin alu_enable=1'b1; alu_control=5'b01111; reg_write=1'b1; end
        6'b010000: begin alu_enable=1'b1; alu_control=5'b10000; reg_write=1'b1; end
        6'b010001: begin alu_enable=1'b1; alu_control=5'b10001; reg_write=1'b1; end
        6'b010010: begin alu_enable=1'b1; alu_control=5'b10010; reg_write=1'b1; end
        6'b010011: begin alu_enable=1'b1; alu_control=5'b10011; reg_write=1'b1; end
        6'b010100: begin alu_enable=1'b1; alu_control=5'b10100; reg_write=1'b1; end
        6'b010101: begin alu_enable=1'b1; alu_control=5'b10101; reg_write=1'b1; end
        6'b010110: begin alu_enable=1'b1; alu_control=5'b10110; reg_write=1'b1; end
        6'b010111: begin alu_enable=1'b1; alu_control=5'b10111; reg_write=1'b1; end
        6'b011000: begin alu_enable=1'b1; alu_control=5'b11000; reg_write=1'b1; end
        6'b011001: begin alu_enable=1'b1; alu_control=5'b11001; reg_write=1'b1; end
        6'b011010: begin alu_enable=1'b1; alu_control=5'b11010; reg_write=1'b1; end
        6'b011011: begin alu_enable=1'b1; alu_control=5'b11011; reg_write=1'b1; end
        6'b011100: begin alu_enable=1'b1; alu_control=5'b11100; reg_write=1'b1; end
        6'b011101: begin alu_enable=1'b1; alu_control=5'b11101; reg_write=1'b1; end
        6'b011110: begin alu_enable=1'b1; alu_control=5'b11110; reg_write=1'b1; end

        6'b011111: begin
            simd_enable = 1'b1;
            reg_write = 1'b1;
        end

        6'b100000: begin
            alu_enable = 1'b1;
            alu_control = 5'b00000;
            alu_src = 1'b1;
            mem_read = 1'b1;
            mem_to_reg = 1'b1;
            reg_write = 1'b1;
        end

        6'b100001: begin
            alu_enable = 1'b1;
            alu_control = 5'b00000;
            alu_src = 1'b1;
            mem_write = 1'b1;
        end

        default: begin
            alu_enable = 1'b0;
            simd_enable = 1'b0;
            alu_control = 5'b00000;
            reg_write = 1'b0;
            alu_src = 1'b0;
            mem_read = 1'b0;
            mem_write = 1'b0;
            mem_to_reg = 1'b0;
        end

    endcase
end
endmodule
