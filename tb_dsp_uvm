// ============================================================
// TEST
// ============================================================

class dsp_test extends uvm_test;

    `uvm_component_utils(dsp_test)


    dsp_env env;


    function new(
        string name = "dsp_test",
        uvm_component parent = null
    );

        super.new(name, parent);

    endfunction


    function void build_phase(uvm_phase phase);

        super.build_phase(phase);


        env =
            dsp_env::type_id::create(
                "env",
                this
            );

    endfunction


    task run_phase(uvm_phase phase);

        dsp_sequence seq;

        bit status;


        phase.raise_objection(this);


        // ====================================================
        // ASSERT RESET
        // ====================================================

        status =
            uvm_hdl_deposit(
                "tb_dsp_uvm.reset",
                1'b1
            );


        if (!status) begin

            `uvm_error(
                "RESET",
                "Could not drive reset"
            )

        end


        #20;


        // ====================================================
        // INITIAL REGISTER VALUES
        // ====================================================

        uvm_hdl_deposit(
            "tb_dsp_uvm.dut.data_path.register_file.registers[0]",
            32'd2
        );

        uvm_hdl_deposit(
            "tb_dsp_uvm.dut.data_path.register_file.registers[1]",
            32'd3
        );

        uvm_hdl_deposit(
            "tb_dsp_uvm.dut.data_path.register_file.registers[2]",
            32'd4
        );

        uvm_hdl_deposit(
            "tb_dsp_uvm.dut.data_path.register_file.registers[3]",
            32'd5
        );

        uvm_hdl_deposit(
            "tb_dsp_uvm.dut.data_path.register_file.registers[4]",
            32'd6
        );

        uvm_hdl_deposit(
            "tb_dsp_uvm.dut.data_path.register_file.registers[5]",
            32'd7
        );

        uvm_hdl_deposit(
            "tb_dsp_uvm.dut.data_path.register_file.registers[6]",
            32'd8
        );

        uvm_hdl_deposit(
            "tb_dsp_uvm.dut.data_path.register_file.registers[7]",
            32'd9
        );


        // ====================================================
        // CLEAR DATA MEMORY
        // ====================================================

        uvm_hdl_deposit(
            "tb_dsp_uvm.dut.data_path.data_mem.memory[0]",
            32'd0
        );


        // ====================================================
        // GENERATE AND LOAD PROGRAM
        // ====================================================

        seq =
            dsp_sequence::type_id::create(
                "seq"
            );


        seq.start(
            env.agent.sequencer
        );


        // ====================================================
        // RELEASE RESET
        // ====================================================

        status =
            uvm_hdl_deposit(
                "tb_dsp_uvm.reset",
                1'b0
            );


        if (!status) begin

            `uvm_error(
                "RESET",
                "Could not release reset"
            )

        end


        // ====================================================
        // WAIT FOR PROCESSOR
        // ====================================================

        #1100;


        phase.drop_objection(this);

    endtask

endclass



// ============================================================
// TOP-LEVEL TESTBENCH
// ============================================================

module tb_dsp_uvm;

    logic clk;
    logic reset;


    // ========================================================
    // DUT
    // ========================================================

    dsp_processor dut (

        .clk   (clk),
        .reset (reset)

    );


    // ========================================================
    // CLOCK
    // ========================================================

    initial begin

        clk = 1'b0;

        forever begin

            #5 clk = ~clk;

        end

    end


    // ========================================================
    // DEFAULT RESET
    // ========================================================

    initial begin

        reset = 1'b1;

    end


    // ========================================================
    // START UVM
    // ========================================================

    initial begin

        run_test("dsp_test");

    end

endmodule
