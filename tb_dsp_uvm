// ============================================================
// TRANSACTION
// ============================================================

class dsp_transaction extends uvm_sequence_item;

    rand bit [5:0]  opcode;
    rand bit [3:0]  rd;
    rand bit [3:0]  rs1;
    rand bit [3:0]  rs2;
    rand bit [13:0] imm;

    bit [31:0] expected_result;
    bit [31:0] actual_result;


    `uvm_object_utils(dsp_transaction)


    function new(string name = "dsp_transaction");

        super.new(name);

    endfunction


    // ========================================================
    // ENCODE INSTRUCTION
    // ========================================================

    function bit [31:0] encode();

        encode = {
            opcode,
            rd,
            rs1,
            rs2,
            imm
        };

    endfunction


    // ========================================================
    // PRINT
    // ========================================================

    function void do_print(uvm_printer printer);

        super.do_print(printer);

        printer.print_field_int(
            "opcode",
            opcode,
            6,
            UVM_HEX
        );

        printer.print_field_int(
            "rd",
            rd,
            4,
            UVM_DEC
        );

        printer.print_field_int(
            "rs1",
            rs1,
            4,
            UVM_DEC
        );

        printer.print_field_int(
            "rs2",
            rs2,
            4,
            UVM_DEC
        );

        printer.print_field_int(
            "imm",
            imm,
            14,
            UVM_HEX
        );

    endfunction

endclass



// ============================================================
// SEQUENCE
// ============================================================

class dsp_sequence extends uvm_sequence #(dsp_transaction);

    `uvm_object_utils(dsp_sequence)


    function new(string name = "dsp_sequence");

        super.new(name);

    endfunction


    task body();

        dsp_transaction tr;


        // ====================================================
        // INSTRUCTION 0
        //
        // ADD
        // R3 = R1 + R2
        //
        // 3 + 4 = 7
        // ====================================================

        tr =
            dsp_transaction::type_id::create("add");

        start_item(tr);

        tr.opcode = 6'b000000;
        tr.rd     = 4'd3;
        tr.rs1    = 4'd1;
        tr.rs2    = 4'd2;
        tr.imm    = 14'd0;

        finish_item(tr);


        // ====================================================
        // INSTRUCTION 1
        //
        // SUB
        // R4 = R3 - R2
        //
        // 7 - 4 = 3
        // ====================================================

        tr =
            dsp_transaction::type_id::create("sub");

        start_item(tr);

        tr.opcode = 6'b000001;
        tr.rd     = 4'd4;
        tr.rs1    = 4'd3;
        tr.rs2    = 4'd2;
        tr.imm    = 14'd0;

        finish_item(tr);


        // ====================================================
        // INSTRUCTION 2
        //
        // MUL
        // R5 = R4 * R2
        //
        // 3 * 4 = 12
        // ====================================================

        tr =
            dsp_transaction::type_id::create("mul");

        start_item(tr);

        tr.opcode = 6'b000010;
        tr.rd     = 4'd5;
        tr.rs1    = 4'd4;
        tr.rs2    = 4'd2;
        tr.imm    = 14'd0;

        finish_item(tr);


        // ====================================================
        // INSTRUCTION 3
        //
        // STORE
        // MEM[0] = R5
        //
        // MEM[0] = 12
        // ====================================================

        tr =
            dsp_transaction::type_id::create("store");

        start_item(tr);

        tr.opcode = 6'b100001;
        tr.rd     = 4'd0;
        tr.rs1    = 4'd5;
        tr.rs2    = 4'd0;
        tr.imm    = 14'd0;

        finish_item(tr);


        // ====================================================
        // INSTRUCTION 4
        //
        // LOAD
        // R6 = MEM[0]
        //
        // R6 = 12
        // ====================================================

        tr =
            dsp_transaction::type_id::create("load");

        start_item(tr);

        tr.opcode = 6'b100000;
        tr.rd     = 4'd6;
        tr.rs1    = 4'd0;
        tr.rs2    = 4'd0;
        tr.imm    = 14'd0;

        finish_item(tr);


        // ====================================================
        // INSTRUCTION 5
        //
        // SIMD MAC
        // R8 = 153
        // ====================================================

        tr =
            dsp_transaction::type_id::create("simd_mac");

        start_item(tr);

        tr.opcode = 6'b011111;
        tr.rd     = 4'd8;
        tr.rs1    = 4'd0;
        tr.rs2    = 4'd4;
        tr.imm    = 14'd0;

        finish_item(tr);


        `uvm_info(
            "SEQUENCE",
            "6 DSP instructions generated",
            UVM_MEDIUM
        )

    endtask

endclass



