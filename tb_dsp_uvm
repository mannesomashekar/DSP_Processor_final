// ============================================================
// DRIVER
// ============================================================

class dsp_driver extends uvm_driver #(dsp_transaction);

    `uvm_component_utils(dsp_driver)


    int instruction_index;


    function new(
        string name = "dsp_driver",
        uvm_component parent = null
    );

        super.new(name, parent);

        instruction_index = 0;

    endfunction


    task run_phase(uvm_phase phase);

        dsp_transaction tr;

        bit status;


        forever begin

            seq_item_port.get_next_item(tr);


            `uvm_info(
                "DRIVER",
                $sformatf(
                    "Instruction %0d = %h",
                    instruction_index,
                    tr.encode()
                ),
                UVM_MEDIUM
            );


            // =================================================
            // WRITE INSTRUCTION MEMORY
            // =================================================

            status =
                uvm_hdl_deposit(
                    $sformatf(
                        "tb_dsp_uvm.dut.instruction_mem.memory[%0d]",
                        instruction_index
                    ),
                    tr.encode()
                );


            if (!status) begin

                `uvm_error(
                    "DRIVER",
                    $sformatf(
                        "Failed to write instruction %0d",
                        instruction_index
                    )
                )

            end
            else begin

                `uvm_info(
                    "DRIVER",
                    $sformatf(
                        "Instruction %0d loaded successfully",
                        instruction_index
                    ),
                    UVM_LOW
                )

            end


            instruction_index++;


            seq_item_port.item_done();

        end

    endtask

endclass



// ============================================================
// MONITOR
// ============================================================

class dsp_monitor extends uvm_monitor;

    `uvm_component_utils(dsp_monitor)


    uvm_analysis_port #(dsp_transaction)
        analysis_port;


    function new(
        string name = "dsp_monitor",
        uvm_component parent = null
    );

        super.new(name, parent);

        analysis_port =
            new("analysis_port", this);

    endfunction


    task run_phase(uvm_phase phase);

        bit        done_value;
        bit [31:0] pc_value;
        bit [31:0] result_value;

        dsp_transaction tr;


        forever begin

            #5;


            // =================================================
            // READ DONE
            // =================================================

            uvm_hdl_read(
                "tb_dsp_uvm.dut.data_path.done",
                done_value
            );


            if (done_value) begin


                // =============================================
                // READ PC
                // =============================================

                uvm_hdl_read(
                    "tb_dsp_uvm.dut.pc",
                    pc_value
                );


                // =============================================
                // READ RESULT
                // =============================================

                uvm_hdl_read(
                    "tb_dsp_uvm.dut.data_path.result",
                    result_value
                );


                tr =
                    dsp_transaction::type_id::create(
                        "monitor_transaction"
                    );


                tr.actual_result =
                    result_value;


                analysis_port.write(tr);


                `uvm_info(
                    "MONITOR",
                    $sformatf(
                        "DONE detected : PC=%0d RESULT=%0d",
                        pc_value,
                        result_value
                    ),
                    UVM_MEDIUM
                );

            end

        end

    endtask

endclass



