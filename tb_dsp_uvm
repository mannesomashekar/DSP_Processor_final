        analysis_export =
            new("analysis_export", this);

    endfunction


    // ========================================================
    // RECEIVE MONITOR TRANSACTION
    // ========================================================

    function void write(dsp_transaction tr);

        `uvm_info(
            "SCOREBOARD",
            $sformatf(
                "Observed result = %0d",
                tr.actual_result
            ),
            UVM_MEDIUM
        );

    endfunction


    // ========================================================
    // FINAL CHECKS
    // ========================================================

    task run_phase(uvm_phase phase);

        bit [31:0] r3_value;
        bit [31:0] r4_value;
        bit [31:0] r5_value;
        bit [31:0] r6_value;
        bit [31:0] r8_value;

        bit [31:0] mem0_value;

        bit [31:0] pc_value;


        // ====================================================
        // WAIT FOR PROCESSOR
        // ====================================================

        #1100;


        // ====================================================
        // READ FINAL VALUES
        // ====================================================

        uvm_hdl_read(
            "tb_dsp_uvm.dut.data_path.register_file.registers[3]",
            r3_value
        );

        uvm_hdl_read(
            "tb_dsp_uvm.dut.data_path.register_file.registers[4]",
            r4_value
        );

        uvm_hdl_read(
            "tb_dsp_uvm.dut.data_path.register_file.registers[5]",
            r5_value
        );

        uvm_hdl_read(
            "tb_dsp_uvm.dut.data_path.register_file.registers[6]",
            r6_value
        );

        uvm_hdl_read(
            "tb_dsp_uvm.dut.data_path.register_file.registers[8]",
            r8_value
        );

        uvm_hdl_read(
            "tb_dsp_uvm.dut.data_path.data_mem.memory[0]",
            mem0_value
        );

        uvm_hdl_read(
            "tb_dsp_uvm.dut.pc",
            pc_value
        );


        // ====================================================
        // PRINT RESULTS
        // ====================================================

        `uvm_info(
            "RESULTS",
            "==============================================",
            UVM_LOW
        );

        `uvm_info(
            "RESULTS",
            "       DSP PROCESSOR UVM RESULTS",
            UVM_LOW
        );

        `uvm_info(
            "RESULTS",
            "==============================================",
            UVM_LOW
        );


        `uvm_info(
            "RESULTS",
            $sformatf(
                "R3  = %0d",
                r3_value
            ),
            UVM_LOW
        );


        `uvm_info(
            "RESULTS",
            $sformatf(
                "R4  = %0d",
                r4_value
            ),
            UVM_LOW
        );


        `uvm_info(
            "RESULTS",
            $sformatf(
                "R5  = %0d",
                r5_value
            ),
            UVM_LOW
        );


        `uvm_info(
            "RESULTS",
            $sformatf(
                "R6  = %0d",
                r6_value
            ),
            UVM_LOW
        );


        `uvm_info(
            "RESULTS",
            $sformatf(
                "R8  = %0d",
                r8_value
            ),
            UVM_LOW
        );


        `uvm_info(
            "RESULTS",
            $sformatf(
                "MEM[0] = %0d",
                mem0_value
            ),
            UVM_LOW
        );


        `uvm_info(
            "RESULTS",
            $sformatf(
                "PC = %0d",
                pc_value
            ),
            UVM_LOW
        );


        // ====================================================
        // ADD CHECK
        // ====================================================

        if (r3_value == 32'd7) begin

            `uvm_info(
                "ADD",
                "ADD PASS : R3 = 7",
                UVM_LOW
            );

        end
        else begin

            `uvm_error(
                "ADD",
                $sformatf(
                    "ADD FAIL : R3 = %0d",
                    r3_value
                )
            );

        end


        // ====================================================
