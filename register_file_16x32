module register_file_16x32(
    input clk,
    input reset,
    input write_enable,
    input read_enable,
    input [3:0] write_addr,
    input [3:0] read_addr,
    input [31:0] d,
    output reg [31:0] q
);

reg [31:0] registers [0:15];

integer i;

always @(posedge clk or posedge reset)
begin
    if (reset)
    begin
        for (i = 0; i < 16; i = i + 1)
            registers[i] <= 32'b0;

        q <= 32'b0;
    end
    else
    begin
        if (write_enable)
            registers[write_addr] <= d;

        if (write_enable)
            q <= d;
        else if (read_enable)
            q <= registers[read_addr];
    end
end
endmodule
