`timescale 1ns / 1ps

module data_memory(
    input clk,
    input reset,
    input mem_read,
    input mem_write,
    input [31:0] address,
    input [31:0] write_data,
    output reg [31:0] read_data
);

reg [31:0] memory [0:255];

integer i;

always @(posedge clk or posedge reset)
begin
    if (reset)
    begin
        for (i = 0; i < 256; i = i + 1)
            memory[i] <= 32'b0;

        read_data <= 32'b0;
    end
    else
    begin
        if (mem_write)
            memory[address[9:2]] <= write_data;

        if (mem_read)
            read_data <= memory[address[9:2]];
        else
            read_data <= 32'b0;
    end
end
endmodule
