module simd_mac_4lane(
      input clk,
      input reset,
      input enable,
      input [31:0] a0,
      input [31:0] b0,
      input [31:0] a1,
      input [31:0] b1,
      input [31:0] a2,
      input [31:0] b2,
      input [31:0] a3,
      input [31:0] b3,
      output reg [63:0] acc
  );

  wire [63:0] product0;
  wire [63:0] product1;
  wire [63:0] product2;
  wire [63:0] product3;

  assign product0 = {32'b0,a0} * {32'b0,b0};
  assign product1 = {32'b0,a1} * {32'b0,b1};
  assign product2 = {32'b0,a2} * {32'b0,b2};
  assign product3 = {32'b0,a3} * {32'b0,b3};

  always @(posedge clk or posedge reset)
  begin
      if (reset)
          acc <= 64'b0;
      else if (enable)
          acc <= acc + product0 + product1 + product2 + product3;
  end
 endmodule
