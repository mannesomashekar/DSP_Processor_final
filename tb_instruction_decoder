`timescale 1ns / 1ps

module tb_instruction_decoder;

reg [31:0] instruction;

wire [5:0] opcode;
wire [3:0] rd;
wire [3:0] rs1;
wire [3:0] rs2;
wire [4:0] alu_control;

wire alu_enable;
wire simd_enable;
wire reg_write;
wire alu_src;
wire mem_read;
wire mem_write;
wire mem_to_reg;

instruction_decoder dut(
    .instruction(instruction),
    .opcode(opcode),
    .rd(rd),
    .rs1(rs1),
    .rs2(rs2),
    .alu_control(alu_control),
    .alu_enable(alu_enable),
    .simd_enable(simd_enable),
    .reg_write(reg_write),
    .alu_src(alu_src),
    .mem_read(mem_read),
    .mem_write(mem_write),
    .mem_to_reg(mem_to_reg)
);

initial
begin

    instruction = 32'b000000_0001_0010_0011_00000000000000;
    #10;
    $display("ADD: opcode=%b alu_control=%b alu_enable=%b reg_write=%b",opcode,alu_control,alu_enable,reg_write);

    instruction = 32'b000001_0001_0010_0011_00000000000000;
    #10;
    $display("SUB: opcode=%b alu_control=%b alu_enable=%b reg_write=%b",opcode,alu_control,alu_enable,reg_write);

    instruction = 32'b000010_0001_0010_0011_00000000000000;
    #10;
    $display("MUL: opcode=%b alu_control=%b alu_enable=%b reg_write=%b",opcode,alu_control,alu_enable,reg_write);

    instruction = 32'b000011_0001_0010_0011_00000000000000;
    #10;
    $display("DIV: opcode=%b alu_control=%b alu_enable=%b reg_write=%b",opcode,alu_control,alu_enable,reg_write);

    instruction = 32'b000100_0001_0010_0011_00000000000000;
    #10;
    $display("POWER: opcode=%b alu_control=%b alu_enable=%b reg_write=%b",opcode,alu_control,alu_enable,reg_write);

    instruction = 32'b000101_0001_0010_0011_00000000000000;
    #10;
    $display("LOGICAL AND: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b000110_0001_0010_0011_00000000000000;
    #10;
    $display("LOGICAL OR: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b000111_0001_0010_0011_00000000000000;
    #10;
    $display("LOGICAL NOT A: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b001000_0001_0010_0011_00000000000000;
    #10;
    $display("LOGICAL NOT B: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b001001_0001_0010_0011_00000000000000;
    #10;
    $display("BITWISE AND: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b001010_0001_0010_0011_00000000000000;
    #10;
    $display("BITWISE OR: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b001011_0001_0010_0011_00000000000000;
    #10;
    $display("BITWISE XOR: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b001100_0001_0010_0011_00000000000000;
    #10;
    $display("BITWISE NOT A: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b001101_0001_0010_0011_00000000000000;
    #10;
    $display("BITWISE NOT B: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b001110_0001_0010_0011_00000000000000;
    #10;
    $display("LEFT SHIFT A: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b001111_0001_0010_0011_00000000000000;
    #10;
    $display("LEFT SHIFT B: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b010000_0001_0010_0011_00000000000000;
    #10;
    $display("RIGHT SHIFT A: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b010001_0001_0010_0011_00000000000000;
    #10;
    $display("RIGHT SHIFT B: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b010010_0001_0010_0011_00000000000000;
    #10;
    $display("ARITHMETIC RIGHT SHIFT A: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b010011_0001_0010_0011_00000000000000;
    #10;
    $display("ARITHMETIC RIGHT SHIFT B: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b010100_0001_0010_0011_00000000000000;
    #10;
    $display("EQUAL: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b010101_0001_0010_0011_00000000000000;
    #10;
    $display("NOT EQUAL: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b010110_0001_0010_0011_00000000000000;
    #10;
    $display("GREATER THAN: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b010111_0001_0010_0011_00000000000000;
    #10;
    $display("LESS THAN: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b011000_0001_0010_0011_00000000000000;
    #10;
    $display("GREATER EQUAL: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b011001_0001_0010_0011_00000000000000;
    #10;
    $display("LESS EQUAL: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b011010_0001_0010_0011_00000000000000;
    #10;
    $display("SIGNED GREATER: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b011011_0001_0010_0011_00000000000000;
    #10;
    $display("SIGNED LESS: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b011100_0001_0010_0011_00000000000000;
    #10;
    $display("SIGNED GREATER EQUAL: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b011101_0001_0010_0011_00000000000000;
    #10;
    $display("SIGNED LESS EQUAL: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b011110_0001_0010_0011_00000000000000;
    #10;
    $display("MODULUS: opcode=%b alu_control=%b",opcode,alu_control);

    instruction = 32'b011111_0001_0010_0011_00000000000000;
    #10;
    $display("SIMD MAC: opcode=%b simd_enable=%b reg_write=%b",opcode,simd_enable,reg_write);

    instruction = 32'b100000_0001_0010_0011_00000000000000;
    #10;
    $display("LOAD: opcode=%b alu_enable=%b mem_read=%b mem_to_reg=%b reg_write=%b",opcode,alu_enable,mem_read,mem_to_reg,reg_write);

    instruction = 32'b100001_0001_0010_0011_00000000000000;
    #10;
    $display("STORE: opcode=%b alu_enable=%b mem_write=%b",opcode,alu_enable,mem_write);

    instruction = 32'b111111_0001_0010_0011_00000000000000;
    #10;
    $display("INVALID: opcode=%b alu_enable=%b simd_enable=%b reg_write=%b",opcode,alu_enable,simd_enable,reg_write);

    #10;
    $finish;
end
endmodule
