`timescale 1ns / 1ps

module tb_instruction_decoder;

reg [31:0] instruction;

wire [5:0] opcode;
wire [3:0] rd;
wire [3:0] rs1;
wire [3:0] rs2;
wire [4:0] alu_control;

wire alu_enable;
wire simd_enable;
wire reg_write;
wire alu_src;
wire mem_read;
wire mem_write;
wire mem_to_reg;

instruction_decoder dut(
    .instruction(instruction),
    .opcode(opcode),
    .rd(rd),
    .rs1(rs1),
    .rs2(rs2),
    .alu_control(alu_control),
    .alu_enable(alu_enable),
    .simd_enable(simd_enable),
    .reg_write(reg_write),
    .alu_src(alu_src),
    .mem_read(mem_read),
    .mem_write(mem_write),
    .mem_to_reg(mem_to_reg)
);

task test_alu;
    input [5:0] op;
    input [4:0] expected_control;

    begin
        instruction = {op,4'b0010,4'b0011,4'b0100,expected_control,9'b0};
        #10;

        if (opcode !== op ||
            rd !== 4'b0010 ||
            rs1 !== 4'b0011 ||
            rs2 !== 4'b0100 ||
            alu_control !== expected_control ||
            alu_enable !== 1'b1 ||
            simd_enable !== 1'b0 ||
            reg_write !== 1'b1)
        begin
            $display("FAIL opcode=%b alu_control=%b",op,expected_control);
        end
        else
        begin
            $display("PASS opcode=%b alu_control=%b",op,expected_control);
        end
    end
endtask

initial
begin
    instruction = 32'b0;

    #10;

    test_alu(6'b000000,5'b00000);
    test_alu(6'b000001,5'b00001);
    test_alu(6'b000010,5'b00010);
    test_alu(6'b000011,5'b00011);
    test_alu(6'b000100,5'b00100);
    test_alu(6'b000101,5'b00101);
    test_alu(6'b000110,5'b00110);
    test_alu(6'b000111,5'b00111);
    test_alu(6'b001000,5'b01000);
    test_alu(6'b001001,5'b01001);
    test_alu(6'b001010,5'b01010);
    test_alu(6'b001011,5'b01011);
    test_alu(6'b001100,5'b01100);
    test_alu(6'b001101,5'b01101);
    test_alu(6'b001110,5'b01110);
    test_alu(6'b001111,5'b01111);
    test_alu(6'b010000,5'b10000);
    test_alu(6'b010001,5'b10001);
    test_alu(6'b010010,5'b10010);
    test_alu(6'b010011,5'b10011);
    test_alu(6'b010100,5'b10100);
    test_alu(6'b010101,5'b10101);
    test_alu(6'b010110,5'b10110);
    test_alu(6'b010111,5'b10111);
    test_alu(6'b011000,5'b11000);
    test_alu(6'b011001,5'b11001);
    test_alu(6'b011010,5'b11010);
    test_alu(6'b011011,5'b11011);
    test_alu(6'b011100,5'b11100);
    test_alu(6'b011101,5'b11101);
    test_alu(6'b011110,5'b11110);

    instruction = {6'b011111,4'b0010,4'b0011,4'b0100,5'b00000,9'b0};
    #10;

    if (opcode !== 6'b011111 ||
        rd !== 4'b0010 ||
        rs1 !== 4'b0011 ||
        rs2 !== 4'b0100 ||
        alu_enable !== 1'b0 ||
        simd_enable !== 1'b1 ||
        reg_write !== 1'b0)
    begin
        $display("FAIL SIMD MAC");
    end
    else
    begin
        $display("PASS SIMD MAC");
    end

    instruction = {6'b111111,26'b0};
    #10;

    if (alu_enable !== 1'b0 ||
        simd_enable !== 1'b0 ||
        reg_write !== 1'b0 ||
        mem_read !== 1'b0 ||
        mem_write !== 1'b0 ||
        mem_to_reg !== 1'b0)
    begin
        $display("FAIL invalid opcode");
    end
    else
    begin
        $display("PASS invalid opcode");
    end

    #10;
    $finish;
end
endmodule
