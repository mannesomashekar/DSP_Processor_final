`timescale 1ns / 1ps

module datapath(
    input clk,
    input reset,
    input [31:0] instruction,

    input alu_enable,
    input simd_enable,
    input reg_write,
    input alu_src,
    input mem_read,
    input mem_write,
    input mem_to_reg,
    input [4:0] alu_control,

    output reg [31:0] result,
    output reg [31:0] write_data,
    output reg [31:0] memory_address,
    output reg [31:0] memory_write_data,
    output reg done
);

wire [5:0] opcode;
wire [3:0] rd;
wire [3:0] rs1;
wire [3:0] rs2;

assign opcode = instruction[31:26];
assign rd = instruction[25:22];
assign rs1 = instruction[21:18];
assign rs2 = instruction[17:14];

wire [31:0] immediate;

immediate_generator imm_gen(
    .instruction(instruction),
    .immediate(immediate)
);

reg register_write_enable;
reg register_read_enable;
reg [3:0] register_write_addr;
reg [3:0] register_read_addr;
reg [31:0] register_write_data;
wire [31:0] register_read_data;

register_file_16x32 register_file(
    .clk(clk),
    .reset(reset),
    .write_enable(register_write_enable),
    .read_enable(register_read_enable),
    .write_addr(register_write_addr),
    .read_addr(register_read_addr),
    .d(register_write_data),
    .q(register_read_data)
);

wire [31:0] memory_read_data;

wire memory_read_enable;
wire memory_write_enable;

reg [5:0] state;

assign memory_read_enable = (state == LOAD_READ);
assign memory_write_enable = (state == STORE_WRITE);

data_memory data_mem(
    .clk(clk),
    .reset(reset),
    .mem_read(memory_read_enable),
    .mem_write(memory_write_enable),
    .address(memory_address),
    .write_data(memory_write_data),
    .read_data(memory_read_data)
);

reg [31:0] operand_a;
reg [31:0] operand_b;

wire [31:0] alu_b;

assign alu_b = alu_src ? immediate : operand_b;

wire [31:0] alu_result;
wire alu_zero;

alu_32 alu(
    .a(operand_a),
    .b(alu_b),
    .alu_control(alu_control),
    .result(alu_result),
    .zero(alu_zero)
);

reg [31:0] simd_a0;
reg [31:0] simd_b0;
reg [31:0] simd_a1;
reg [31:0] simd_b1;
reg [31:0] simd_a2;
reg [31:0] simd_b2;
reg [31:0] simd_a3;
reg [31:0] simd_b3;

reg simd_mac_enable;
wire [63:0] simd_result;

simd_mac_4lane simd_mac(
    .clk(clk),
    .reset(reset),
    .enable(simd_mac_enable),
    .a0(simd_a0),
    .b0(simd_b0),
    .a1(simd_a1),
    .b1(simd_b1),
    .a2(simd_a2),
    .b2(simd_b2),
    .a3(simd_a3),
    .b3(simd_b3),
    .acc(simd_result)
);

localparam IDLE = 6'd0;

localparam ALU_READ_RS1 = 6'd1;
localparam ALU_CAPTURE_RS1 = 6'd2;
localparam ALU_READ_RS2 = 6'd3;
localparam ALU_CAPTURE_RS2 = 6'd4;
localparam ALU_EXECUTE = 6'd5;
localparam ALU_WRITE_BACK = 6'd6;

localparam SIMD_READ_A0 = 6'd10;
localparam SIMD_CAPTURE_A0 = 6'd11;
localparam SIMD_READ_B0 = 6'd12;
localparam SIMD_CAPTURE_B0 = 6'd13;
localparam SIMD_READ_A1 = 6'd14;
localparam SIMD_CAPTURE_A1 = 6'd15;
localparam SIMD_READ_B1 = 6'd16;
localparam SIMD_CAPTURE_B1 = 6'd17;
localparam SIMD_READ_A2 = 6'd18;
localparam SIMD_CAPTURE_A2 = 6'd19;
localparam SIMD_READ_B2 = 6'd20;
localparam SIMD_CAPTURE_B2 = 6'd21;
localparam SIMD_READ_A3 = 6'd22;
localparam SIMD_CAPTURE_A3 = 6'd23;
localparam SIMD_READ_B3 = 6'd24;
localparam SIMD_CAPTURE_B3 = 6'd25;
localparam SIMD_EXECUTE = 6'd26;
localparam SIMD_WAIT = 6'd27;
localparam SIMD_WRITE_BACK = 6'd28;

localparam LOAD_ADDRESS = 6'd30;
localparam LOAD_READ = 6'd31;
localparam LOAD_WAIT = 6'd32;
localparam LOAD_WRITE_BACK = 6'd33;

localparam STORE_READ_RS1 = 6'd40;
localparam STORE_CAPTURE_RS1 = 6'd41;
localparam STORE_READ_RS2 = 6'd42;
localparam STORE_CAPTURE_RS2 = 6'd43;
localparam STORE_WRITE = 6'd44;
localparam STORE_DONE = 6'd45;

localparam WAIT_NEXT = 6'd46;

always @(posedge clk or posedge reset)
begin
    if (reset)
    begin
        state <= IDLE;

        operand_a <= 32'b0;
        operand_b <= 32'b0;

        simd_a0 <= 32'b0;
        simd_b0 <= 32'b0;
        simd_a1 <= 32'b0;
        simd_b1 <= 32'b0;
        simd_a2 <= 32'b0;
        simd_b2 <= 32'b0;
        simd_a3 <= 32'b0;
        simd_b3 <= 32'b0;

        result <= 32'b0;
        write_data <= 32'b0;
        memory_address <= 32'b0;
        memory_write_data <= 32'b0;
        done <= 1'b0;

        register_write_enable <= 1'b0;
        register_read_enable <= 1'b0;
        register_write_addr <= 4'b0;
        register_read_addr <= 4'b0;
        register_write_data <= 32'b0;

        simd_mac_enable <= 1'b0;
    end
    else
    begin
        done <= 1'b0;
        register_write_enable <= 1'b0;
        register_read_enable <= 1'b0;
        simd_mac_enable <= 1'b0;

        case (state)

            IDLE:
            begin
                if (simd_enable)
                begin
                    register_read_addr <= 4'd0;
                    register_read_enable <= 1'b1;
                    state <= SIMD_READ_A0;
                end

                else if (mem_read)
                begin
                    register_read_addr <= rs1;
                    register_read_enable <= 1'b1;
                    state <= ALU_READ_RS1;
                end

                else if (mem_write)
                begin
                    register_read_addr <= rs1;
                    register_read_enable <= 1'b1;
                    state <= STORE_READ_RS1;
                end

                else if (alu_enable)
                begin
                    register_read_addr <= rs1;
                    register_read_enable <= 1'b1;
                    state <= ALU_READ_RS1;
                end
            end

            ALU_READ_RS1:
            begin
                state <= ALU_CAPTURE_RS1;
            end

            ALU_CAPTURE_RS1:
            begin
                operand_a <= register_read_data;

                if (mem_read)
                begin
                    register_read_enable <= 1'b0;
                    state <= LOAD_ADDRESS;
                end

                else if (alu_src)
                begin
                    register_read_enable <= 1'b0;
                    state <= ALU_EXECUTE;
                end

                else
                begin
                    register_read_addr <= rs2;
                    register_read_enable <= 1'b1;
                    state <= ALU_READ_RS2;
                end
            end

            ALU_READ_RS2:
            begin
                state <= ALU_CAPTURE_RS2;
            end

            ALU_CAPTURE_RS2:
            begin
                operand_b <= register_read_data;
                register_read_enable <= 1'b0;
                state <= ALU_EXECUTE;
            end

            ALU_EXECUTE:
            begin
                result <= alu_result;
                state <= ALU_WRITE_BACK;
            end

            ALU_WRITE_BACK:
            begin
                if (reg_write)
                begin
                    register_write_enable <= 1'b1;
                    register_write_addr <= rd;
                    register_write_data <= result;
                end

                write_data <= result;
                done <= 1'b1;
                state <= WAIT_NEXT;
            end

            LOAD_ADDRESS:
            begin
                memory_address <= operand_a + immediate;
                state <= LOAD_READ;
            end

            LOAD_READ:
            begin
                state <= LOAD_WAIT;
            end

            LOAD_WAIT:
            begin
                result <= memory_read_data;
                state <= LOAD_WRITE_BACK;
            end

            LOAD_WRITE_BACK:
            begin
                if (reg_write)
                begin
                    register_write_enable <= 1'b1;
                    register_write_addr <= rd;
                    register_write_data <= result;
                end

                write_data <= result;
                done <= 1'b1;
                state <= WAIT_NEXT;
            end

            STORE_READ_RS1:
            begin
                state <= STORE_CAPTURE_RS1;
            end

            STORE_CAPTURE_RS1:
            begin
                operand_a <= register_read_data;
                register_read_addr <= rs2;
                register_read_enable <= 1'b1;
                state <= STORE_READ_RS2;
            end

            STORE_READ_RS2:
            begin
                state <= STORE_CAPTURE_RS2;
            end

            STORE_CAPTURE_RS2:
            begin
                operand_b <= register_read_data;

                memory_address <= operand_a + immediate;
                memory_write_data <= register_read_data;

                register_read_enable <= 1'b0;
                state <= STORE_WRITE;
            end

            STORE_WRITE:
            begin
                state <= STORE_DONE;
            end

            STORE_DONE:
            begin
                done <= 1'b1;
                state <= WAIT_NEXT;
            end

            WAIT_NEXT:
            begin
                state <= IDLE;
            end

            SIMD_READ_A0:
            begin
                state <= SIMD_CAPTURE_A0;
            end

            SIMD_CAPTURE_A0:
            begin
                simd_a0 <= register_read_data;
                register_read_addr <= 4'd1;
                register_read_enable <= 1'b1;
                state <= SIMD_READ_B0;
            end

            SIMD_READ_B0:
            begin
                state <= SIMD_CAPTURE_B0;
            end

            SIMD_CAPTURE_B0:
            begin
                simd_b0 <= register_read_data;
                register_read_addr <= 4'd2;
                register_read_enable <= 1'b1;
                state <= SIMD_READ_A1;
            end

            SIMD_READ_A1:
            begin
                state <= SIMD_CAPTURE_A1;
            end

            SIMD_CAPTURE_A1:
            begin
                simd_a1 <= register_read_data;
                register_read_addr <= 4'd3;
                register_read_enable <= 1'b1;
                state <= SIMD_READ_B1;
            end

            SIMD_READ_B1:
            begin
                state <= SIMD_CAPTURE_B1;
            end

            SIMD_CAPTURE_B1:
            begin
                simd_b1 <= register_read_data;
                register_read_addr <= 4'd4;
                register_read_enable <= 1'b1;
                state <= SIMD_READ_A2;
            end

            SIMD_READ_A2:
            begin
                state <= SIMD_CAPTURE_A2;
            end

            SIMD_CAPTURE_A2:
            begin
                simd_a2 <= register_read_data;
                register_read_addr <= 4'd5;
                register_read_enable <= 1'b1;
                state <= SIMD_READ_B2;
            end

            SIMD_READ_B2:
            begin
                state <= SIMD_CAPTURE_B2;
            end

            SIMD_CAPTURE_B2:
            begin
                simd_b2 <= register_read_data;
                register_read_addr <= 4'd6;
                register_read_enable <= 1'b1;
                state <= SIMD_READ_A3;
            end

            SIMD_READ_A3:
            begin
                state <= SIMD_CAPTURE_A3;
            end

            SIMD_CAPTURE_A3:
            begin
                simd_a3 <= register_read_data;
                register_read_addr <= 4'd7;
                register_read_enable <= 1'b1;
                state <= SIMD_READ_B3;
            end

            SIMD_READ_B3:
            begin
                state <= SIMD_CAPTURE_B3;
            end

            SIMD_CAPTURE_B3:
            begin
                simd_b3 <= register_read_data;
                register_read_enable <= 1'b0;
                state <= SIMD_EXECUTE;
            end

            SIMD_EXECUTE:
            begin
                simd_mac_enable <= 1'b1;
                state <= SIMD_WAIT;
            end

            SIMD_WAIT:
            begin
                state <= SIMD_WRITE_BACK;
            end

            SIMD_WRITE_BACK:
            begin
                if (reg_write)
                begin
                    register_write_enable <= 1'b1;
                    register_write_addr <= rd;
                    register_write_data <= simd_result[31:0];
                end

                result <= simd_result[31:0];
                write_data <= simd_result[31:0];
                done <= 1'b1;
                state <= WAIT_NEXT;
            end

            default:
            begin
                state <= IDLE;
            end

        endcase
    end
end
endmodule
