module tb_instruction_format;

reg [31:0] instruction;
wire [5:0] opcode;
wire [3:0] rd;
wire [3:0] rs1;
wire [3:0] rs2;
wire [4:0] alu_control;

instruction_format uut(
    .instruction(instruction),
    .opcode(opcode),
    .rd(rd),
    .rs1(rs1),
    .rs2(rs2),
    .alu_control(alu_control)
);

initial
begin
    #10 instruction = 32'b000000_0010_0011_0100_00000_000000000;
    #10 instruction = 32'b000000_0100_0101_0110_00001_000000000;
    #10 instruction = 32'b000001_0010_0011_0100_00000_000000000;
    #10 instruction = 32'b011110_0010_0011_0100_00000_000000000;
    #10 instruction = 32'b100000_0100_0101_0110_00000_000000000;
    #10 $finish;
end
endmodule
