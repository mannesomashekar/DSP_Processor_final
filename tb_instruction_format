`timescale 1ns / 1ps

module tb_instruction_format;

reg [31:0] instruction;

wire [5:0] opcode;
wire [3:0] rd;
wire [3:0] rs1;
wire [3:0] rs2;
wire [13:0] function_field;

instruction_format dut(
    .instruction(instruction),
    .opcode(opcode),
    .rd(rd),
    .rs1(rs1),
    .rs2(rs2),
    .function_field(function_field)
);

initial
begin

    instruction = 32'b000000_0001_0010_0011_00000000000000;
    #10;

    $display("test 1");
    $display("instruction = %b",instruction);
    $display("opcode = %b",opcode);
    $display("rd = %b",rd);
    $display("rs1 = %b",rs1);
    $display("rs2 = %b",rs2);
    $display("function_field = %b",function_field);

    #10;

    instruction = 32'b000001_0010_0011_0100_10101010101010;
    #10;

    $display("test 2");
    $display("instruction = %b",instruction);
    $display("opcode = %b",opcode);
    $display("rd = %b",rd);
    $display("rs1 = %b",rs1);
    $display("rs2 = %b",rs2);
    $display("function_field = %b",function_field);

    #10;

    instruction = 32'b011111_0100_0101_0110_11110000111100;
    #10;

    $display("test 3");
    $display("instruction = %b",instruction);
    $display("opcode = %b",opcode);
    $display("rd = %b",rd);
    $display("rs1 = %b",rs1);
    $display("rs2 = %b",rs2);
    $display("function_field = %b",function_field);

    #10;

    $finish;
end
endmodule
