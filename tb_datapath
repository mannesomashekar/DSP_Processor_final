`timescale 1ns / 1ps

module tb_datapath;

reg clk;
reg reset;
reg [31:0] instruction;

reg alu_enable;
reg simd_enable;
reg reg_write;
reg alu_src;
reg mem_read;
reg mem_write;
reg mem_to_reg;
reg [4:0] alu_control;

wire [31:0] result;
wire [31:0] write_data;
wire done;

datapath dut(
    .clk(clk),
    .reset(reset),
    .instruction(instruction),
    .alu_enable(alu_enable),
    .simd_enable(simd_enable),
    .reg_write(reg_write),
    .alu_src(alu_src),
    .mem_read(mem_read),
    .mem_write(mem_write),
    .mem_to_reg(mem_to_reg),
    .alu_control(alu_control),
    .result(result),
    .write_data(write_data),
    .done(done)
);

always #5 clk = ~clk;

initial
begin
    clk = 1'b0;
    reset = 1'b1;
    instruction = 32'b0;

    alu_enable = 1'b0;
    simd_enable = 1'b0;
    reg_write = 1'b0;
    alu_src = 1'b0;
    mem_read = 1'b0;
    mem_write = 1'b0;
    mem_to_reg = 1'b0;
    alu_control = 5'b00000;

    #10;

    reset = 1'b0;

    // initialize registers for simulation
    dut.register_file.registers[2] = 32'd20;
    dut.register_file.registers[3] = 32'd10;

    // add r1,r2,r3
    instruction = 32'b000000_0001_0010_0011_00000000000000;

    alu_enable = 1'b1;
    reg_write = 1'b1;
    alu_src = 1'b0;
    alu_control = 5'b00000;

    #60;

    $display("ADD TEST");
    $display("r2 = %d",dut.register_file.registers[2]);
    $display("r3 = %d",dut.register_file.registers[3]);
    $display("r1 = %d",dut.register_file.registers[1]);
    $display("result = %d",result);
    $display("done = %b",done);

    if (dut.register_file.registers[1] == 32'd30)
        $display("ADD PASS");
    else
        $display("ADD FAIL");

    #10;

    // change register values
    dut.register_file.registers[2] = 32'd50;
    dut.register_file.registers[3] = 32'd20;

    // sub r4,r2,r3
    instruction = 32'b000001_0100_0010_0011_00000000000000;

    alu_enable = 1'b1;
    reg_write = 1'b1;
    alu_src = 1'b0;
    alu_control = 5'b00001;

    #60;

    $display("SUB TEST");
    $display("r2 = %d",dut.register_file.registers[2]);
    $display("r3 = %d",dut.register_file.registers[3]);
    $display("r4 = %d",dut.register_file.registers[4]);
    $display("result = %d",result);
    $display("done = %b",done);

    if (dut.register_file.registers[4] == 32'd30)
        $display("SUB PASS");
    else
        $display("SUB FAIL");

    #10;

    // change register values
    dut.register_file.registers[2] = 32'd100;
    dut.register_file.registers[3] = 32'd25;

    // and r5,r2,r3
    instruction = 32'b001001_0101_0010_0011_00000000000000;

    alu_enable = 1'b1;
    reg_write = 1'b1;
    alu_src = 1'b0;
    alu_control = 5'b01001;

    #60;

    $display("BITWISE AND TEST");
    $display("r5 = %h",dut.register_file.registers[5]);
    $display("result = %h",result);
    $display("done = %b",done);

    if (dut.register_file.registers[5] == (32'd100 & 32'd25))
        $display("BITWISE AND PASS");
    else
        $display("BITWISE AND FAIL");

    #10;

    $finish;
end
endmodule
