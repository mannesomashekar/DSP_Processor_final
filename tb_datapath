`timescale 1ns / 1ps

module tb_datapath;

reg clk;
reg reset;
reg [31:0] instruction;

reg alu_enable;
reg simd_enable;
reg reg_write;
reg alu_src;
reg mem_read;
reg mem_write;
reg mem_to_reg;
reg [4:0] alu_control;

wire [31:0] result;
wire [31:0] write_data;
wire [31:0] memory_address;
wire [31:0] memory_write_data;
wire done;

datapath dut(
    .clk(clk),
    .reset(reset),
    .instruction(instruction),
    .alu_enable(alu_enable),
    .simd_enable(simd_enable),
    .reg_write(reg_write),
    .alu_src(alu_src),
    .mem_read(mem_read),
    .mem_write(mem_write),
    .mem_to_reg(mem_to_reg),
    .alu_control(alu_control),
    .result(result),
    .write_data(write_data),
    .memory_address(memory_address),
    .memory_write_data(memory_write_data),
    .done(done)
);

always #5 clk = ~clk;

initial
begin
    clk = 1'b0;
    reset = 1'b1;
    instruction = 32'b0;

    alu_enable = 1'b0;
    simd_enable = 1'b0;
    reg_write = 1'b0;
    alu_src = 1'b0;
    mem_read = 1'b0;
    mem_write = 1'b0;
    mem_to_reg = 1'b0;
    alu_control = 5'b00000;

    #10;

    reset = 1'b0;

    // r2 = value to store
    // r1 = base address
    dut.register_file.registers[1] = 32'd0;
    dut.register_file.registers[2] = 32'h12345678;

    // store r2 -> memory[0]
    instruction = 32'b100001_0000_0001_0010_00000000000000;

    alu_enable = 1'b1;
    simd_enable = 1'b0;
    reg_write = 1'b0;
    alu_src = 1'b1;
    mem_read = 1'b0;
    mem_write = 1'b1;
    mem_to_reg = 1'b0;
    alu_control = 5'b00000;

    #80;

    $display("STORE TEST");
    $display("address = %d",memory_address);
    $display("write_data = %h",memory_write_data);
    $display("memory[0] = %h",dut.data_mem.memory[0]);
    $display("done = %b",done);

    if (dut.data_mem.memory[0] == 32'h12345678)
        $display("STORE PASS");
    else
        $display("STORE FAIL");

    #10;

    // load memory[0] -> r3
    instruction = 32'b100000_0011_0001_0000_00000000000000;

    alu_enable = 1'b1;
    simd_enable = 1'b0;
    reg_write = 1'b1;
    alu_src = 1'b1;
    mem_read = 1'b1;
    mem_write = 1'b0;
    mem_to_reg = 1'b1;
    alu_control = 5'b00000;

    #80;

    $display("LOAD TEST");
    $display("address = %d",memory_address);
    $display("result = %h",result);
    $display("r3 = %h",dut.register_file.registers[3]);
    $display("done = %b",done);

    if (dut.register_file.registers[3] == 32'h12345678)
        $display("LOAD PASS");
    else
        $display("LOAD FAIL");

    #10;

    $finish;
end
endmodule
