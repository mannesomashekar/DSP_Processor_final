`timescale 1ns / 1ps

module tb_datapath;

reg clk;
reg reset;
reg [31:0] instruction;

reg alu_enable;
reg simd_enable;
reg reg_write;
reg alu_src;
reg mem_read;
reg mem_write;
reg mem_to_reg;
reg [4:0] alu_control;

wire [31:0] result;
wire [31:0] write_data;
wire done;

datapath dut(
    .clk(clk),
    .reset(reset),
    .instruction(instruction),
    .alu_enable(alu_enable),
    .simd_enable(simd_enable),
    .reg_write(reg_write),
    .alu_src(alu_src),
    .mem_read(mem_read),
    .mem_write(mem_write),
    .mem_to_reg(mem_to_reg),
    .alu_control(alu_control),
    .result(result),
    .write_data(write_data),
    .done(done)
);

always #5 clk = ~clk;

initial
begin
    clk = 1'b0;
    reset = 1'b1;
    instruction = 32'b0;

    alu_enable = 1'b0;
    simd_enable = 1'b0;
    reg_write = 1'b0;
    alu_src = 1'b0;
    mem_read = 1'b0;
    mem_write = 1'b0;
    mem_to_reg = 1'b0;
    alu_control = 5'b00000;

    #10;

    reset = 1'b0;

    // initialize registers
    dut.register_file.registers[0] = 32'd2;
    dut.register_file.registers[1] = 32'd3;
    dut.register_file.registers[2] = 32'd4;
    dut.register_file.registers[3] = 32'd5;
    dut.register_file.registers[4] = 32'd6;
    dut.register_file.registers[5] = 32'd7;
    dut.register_file.registers[6] = 32'd8;
    dut.register_file.registers[7] = 32'd9;

    // SIMD instruction
    instruction = 32'b011111_1000_0000_0000_00000000000000;

    alu_enable = 1'b0;
    simd_enable = 1'b1;
    reg_write = 1'b1;

    #200;

    $display("SIMD MAC TEST");
    $display("R0 = %d",dut.register_file.registers[0]);
    $display("R1 = %d",dut.register_file.registers[1]);
    $display("R2 = %d",dut.register_file.registers[2]);
    $display("R3 = %d",dut.register_file.registers[3]);
    $display("R4 = %d",dut.register_file.registers[4]);
    $display("R5 = %d",dut.register_file.registers[5]);
    $display("R6 = %d",dut.register_file.registers[6]);
    $display("R7 = %d",dut.register_file.registers[7]);
    $display("R8 = %d",dut.register_file.registers[8]);
    $display("result = %d",result);
    $display("write_data = %d",write_data);
    $display("done = %b",done);

    if (dut.register_file.registers[8] == 32'd140)
        $display("SIMD MAC PASS");
    else
        $display("SIMD MAC FAIL");

    #10;

    $finish;
end
endmodule
