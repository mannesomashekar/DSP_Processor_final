`timescale 1ns / 1ps

module simd_datapath(
    input clk,
    input reset,
    input enable,
    input [3:0] rd,

    output reg [31:0] result,
    output reg write_enable,
    output reg [3:0] write_addr,
    output reg done
);

reg register_read_enable;
reg [3:0] register_read_addr;
wire [31:0] register_read_data;

reg [31:0] a0;
reg [31:0] b0;
reg [31:0] a1;
reg [31:0] b1;
reg [31:0] a2;
reg [31:0] b2;
reg [31:0] a3;
reg [31:0] b3;

reg mac_enable;
wire [63:0] mac_result;

reg [3:0] state;

localparam IDLE = 4'd0;
localparam READ_A0 = 4'd1;
localparam CAPTURE_A0 = 4'd2;
localparam READ_B0 = 4'd3;
localparam CAPTURE_B0 = 4'd4;
localparam READ_A1 = 4'd5;
localparam CAPTURE_A1 = 4'd6;
localparam READ_B1 = 4'd7;
localparam CAPTURE_B1 = 4'd8;
localparam READ_A2 = 4'd9;
localparam CAPTURE_A2 = 4'd10;
localparam READ_B2 = 4'd11;
localparam CAPTURE_B2 = 4'd12;
localparam READ_A3 = 4'd13;
localparam CAPTURE_A3 = 4'd14;
localparam READ_B3 = 4'd15;

register_file_16x32 register_file(
    .clk(clk),
    .reset(reset),
    .write_enable(1'b0),
    .read_enable(register_read_enable),
    .write_addr(4'b0),
    .read_addr(register_read_addr),
    .d(32'b0),
    .q(register_read_data)
);

simd_mac_4lane mac(
    .clk(clk),
    .reset(reset),
    .enable(mac_enable),
    .a0(a0),
    .b0(b0),
    .a1(a1),
    .b1(b1),
    .a2(a2),
    .b2(b2),
    .a3(a3),
    .b3(b3),
    .acc(mac_result)
);

always @(posedge clk or posedge reset)
begin
    if (reset)
    begin
        state <= IDLE;

        register_read_enable <= 1'b0;
        register_read_addr <= 4'b0;

        a0 <= 32'b0;
        b0 <= 32'b0;
        a1 <= 32'b0;
        b1 <= 32'b0;
        a2 <= 32'b0;
        b2 <= 32'b0;
        a3 <= 32'b0;
        b3 <= 32'b0;

        mac_enable <= 1'b0;

        result <= 32'b0;
        write_enable <= 1'b0;
        write_addr <= 4'b0;
        done <= 1'b0;
    end
    else
    begin
        register_read_enable <= 1'b0;
        mac_enable <= 1'b0;
        write_enable <= 1'b0;
        done <= 1'b0;

        case (state)

            IDLE:
            begin
                if (enable)
                begin
                    register_read_addr <= 4'd0;
                    register_read_enable <= 1'b1;
                    state <= READ_A0;
                end
            end

            READ_A0:
            begin
                state <= CAPTURE_A0;
            end

            CAPTURE_A0:
            begin
                a0 <= register_read_data;
                register_read_addr <= 4'd1;
                register_read_enable <= 1'b1;
                state <= READ_B0;
            end

            READ_B0:
            begin
                state <= CAPTURE_B0;
            end

            CAPTURE_B0:
            begin
                b0 <= register_read_data;
                register_read_addr <= 4'd2;
                register_read_enable <= 1'b1;
                state <= READ_A1;
            end

            READ_A1:
            begin
                state <= CAPTURE_A1;
            end

            CAPTURE_A1:
            begin
                a1 <= register_read_data;
                register_read_addr <= 4'd3;
                register_read_enable <= 1'b1;
                state <= READ_B1;
            end

            READ_B1:
            begin
                state <= CAPTURE_B1;
            end

            CAPTURE_B1:
            begin
                b1 <= register_read_data;
                register_read_addr <= 4'd4;
                register_read_enable <= 1'b1;
                state <= READ_A2;
            end

            READ_A2:
            begin
                state <= CAPTURE_A2;
            end

            CAPTURE_A2:
            begin
                a2 <= register_read_data;
                register_read_addr <= 4'd5;
                register_read_enable <= 1'b1;
                state <= READ_B2;
            end

            READ_B2:
            begin
                state <= CAPTURE_B2;
            end

            CAPTURE_B2:
            begin
                b2 <= register_read_data;
                register_read_addr <= 4'd6;
                register_read_enable <= 1'b1;
                state <= READ_A3;
            end

            READ_A3:
            begin
                state <= CAPTURE_A3;
            end

            CAPTURE_A3:
            begin
                a3 <= register_read_data;
                register_read_addr <= 4'd7;
                register_read_enable <= 1'b1;
                state <= READ_B3;
            end

            READ_B3:
            begin
                state <= CAPTURE_B3;
            end

            CAPTURE_B3:
            begin
                b3 <= register_read_data;
                register_read_enable <= 1'b0;
                mac_enable <= 1'b1;
                state <= DONE;
            end

            DONE:
            begin
                result <= mac_result[31:0];
                write_addr <= rd;
                write_enable <= 1'b1;
                done <= 1'b1;
                state <= IDLE;
            end

            default:
            begin
                state <= IDLE;
            end

        endcase
    end
